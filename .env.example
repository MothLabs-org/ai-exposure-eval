# ─────────────────────────────────────────────────────────────────────────────
# Job Evaluation Pipeline — environment variable overrides
#
# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.
#
# Priority: CLI args > env vars (.env) > pipeline_config.json > built-in defaults
# ─────────────────────────────────────────────────────────────────────────────

# Server
EVAL_SERVER_IP=YOUR_SERVER_IP         # e.g. 192.168.1.100 or localhost
EVAL_SERVER_PORT=8000                 # vLLM default; Ollama uses 11434

# Model names (use different ports if teacher/student are on separate servers)
EVAL_TEACHER_MODEL=YOUR_MODEL_NAME    # e.g. meta-llama/Llama-3-8B-Instruct
EVAL_STUDENT_MODEL=YOUR_MODEL_NAME
EVAL_JUDGE_MODEL=YOUR_MODEL_NAME

# Optional: separate teacher/student/judge servers
# (any judge setting left unset falls back to the teacher's)
# EVAL_TEACHER_IP=127.0.0.1
# EVAL_STUDENT_IP=127.0.0.1
# EVAL_JUDGE_IP=127.0.0.1
# EVAL_TEACHER_PORT=8000
# EVAL_STUDENT_PORT=8001
# EVAL_JUDGE_PORT=8002

# Optional: hosted / HTTPS endpoints — a base URL replaces IP/port for that role
# EVAL_TEACHER_BASE_URL=https://api.openai.com/v1
# EVAL_STUDENT_BASE_URL=
# EVAL_JUDGE_BASE_URL=

# API keys (sent as "Authorization: Bearer <key>"). EVAL_API_KEY covers every role
# without its own key. Keys are read from the environment only.
# EVAL_API_KEY=
# EVAL_TEACHER_API_KEY=
# EVAL_STUDENT_API_KEY=
# EVAL_JUDGE_API_KEY=

# vLLM/Qwen3 thinking flag (chat_template_kwargs.enable_thinking=false).
# Default: on for IP/port endpoints, off for base-URL endpoints. Set 1 or 0 to force.
# EVAL_TEACHER_THINKING_TOGGLE=
# EVAL_STUDENT_THINKING_TOGGLE=
# EVAL_JUDGE_THINKING_TOGGLE=
